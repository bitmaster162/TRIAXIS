{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_evidence_package_v1.schema.json",
  "title": "TRIAXIS Evidence Package v1",
  "type": "object",
  "required": ["contract_id", "evaluation_tick", "sources", "claims", "package_sha256"],
  "properties": {
    "contract_id": {"const": "TRIAXIS_EVIDENCE_PACKAGE_v1"},
    "evaluation_tick": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "source_id", "subject_id", "source_group", "publisher_id", "source_type", "polarity", "attestation_level", "content_sha256", "observed_at", "valid_until", "upstream_ids", "source_sha256"]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "claim_id", "subject_id", "claim_kind", "load_bearing", "required_independent_groups", "required_attestation", "requires_authoritative_adapter", "evidence_ids", "claim_sha256"]
      }
    },
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
