{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_policy_head_quorum_config_v1.schema.json",
  "title": "TRIAXIS Policy Head Quorum Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "config_id",
    "authority_set_id",
    "policy_id",
    "threshold",
    "authorities",
    "minimum_policy_version",
    "minimum_policy_sha256",
    "valid_from",
    "valid_until",
    "config_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_POLICY_HEAD_QUORUM_CONFIG_v1"},
    "config_id": {"type": "string", "minLength": 1},
    "authority_set_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "threshold": {"type": "integer", "minimum": 2},
    "authorities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "signer_id", "key_id", "trust_domain"],
        "properties": {
          "authority_id": {"type": "string", "minLength": 1},
          "signer_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "trust_domain": {"type": "string", "minLength": 1}
        }
      }
    },
    "minimum_policy_version": {"type": "integer", "minimum": 1},
    "minimum_policy_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "valid_from": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
