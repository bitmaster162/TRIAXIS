{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_granted": {
      "const": false
    },
    "contract_id": {
      "const": "TRIAXIS_PROVIDER_NATIVE_IDEMPOTENCY_EVENT_v1"
    },
    "effect_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "from_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "minimum": 1,
      "type": "integer"
    },
    "issued_at": {
      "minimum": 0,
      "type": "integer"
    },
    "namespace_id": {
      "minLength": 1,
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "previous_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "type": "string"
    },
    "provider_request_id": {
      "minLength": 1,
      "type": "string"
    },
    "provider_response_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "service_id": {
      "minLength": 1,
      "type": "string"
    },
    "to_state": {
      "enum": [
        "IN_FLIGHT",
        "UNKNOWN",
        "COMPLETED",
        "NO_EFFECT"
      ]
    },
    "valid_until": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "provider_id",
    "service_id",
    "namespace_id",
    "sequence",
    "previous_event_sha256",
    "effect_id",
    "payload_sha256",
    "provider_request_id",
    "generation",
    "from_state",
    "to_state",
    "provider_response_sha256",
    "evidence_sha256",
    "issued_at",
    "valid_until",
    "authority_granted",
    "event_sha256"
  ],
  "type": "object"
}
