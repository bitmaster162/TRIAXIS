{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_assurance_pass_attestation_v1.schema.json",
  "title": "TRIAXIS Assurance PASS Attestation v1",
  "type": "object",
  "required": [
    "contract_id", "attestation_id", "issuer_id", "trust_domain", "subject_id",
    "decision_case_sha256", "evidence_report_sha256", "assurance_status",
    "synthesis_decision", "attestation_level", "issued_at", "valid_until",
    "attestation_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_ASSURANCE_PASS_ATTESTATION_v1"},
    "attestation_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "trust_domain": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "decision_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assurance_status": {"const": "PASS"},
    "synthesis_decision": {"enum": ["ACCEPT", "ACCEPT_WITH_CONTROLS"]},
    "attestation_level": {"enum": ["AUTHENTICATED", "HARDWARE_ROOTED"]},
    "issued_at": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
