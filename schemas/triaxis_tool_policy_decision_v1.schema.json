{
  "$id": "https://triaxis.local/schemas/triaxis_tool_policy_decision_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_TOOL_POLICY_DECISION_v1"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "ASK_USER",
        "DENY"
      ]
    },
    "decision_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "matched_rule_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "PLAN",
        "DEFAULT",
        "AUTO_EDIT",
        "HEADLESS"
      ]
    },
    "model_visibility": {
      "enum": [
        "VISIBLE",
        "HIDDEN"
      ]
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "selected_rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_rule_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "contract_id",
    "request_sha256",
    "mode",
    "decision",
    "selected_rule_sha256",
    "selected_rule_id",
    "matched_rule_sha256s",
    "model_visibility",
    "decision_sha256"
  ],
  "title": "TRIAXIS Tool Policy Decision v1",
  "type": "object"
}
