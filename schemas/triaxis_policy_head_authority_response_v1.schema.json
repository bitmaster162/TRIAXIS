{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_policy_head_authority_response_v1.schema.json",
  "title": "TRIAXIS Policy Head Authority Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "authority_id",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "verifier_id",
    "verifier_epoch_sha256",
    "challenge_sha256",
    "requested_at",
    "issued_at",
    "valid_until",
    "response_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_POLICY_HEAD_AUTHORITY_RESPONSE_v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_epoch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "challenge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
