{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_action_assurance_envelope_v1.schema.json",
  "title": "TRIAXIS Action Assurance Envelope v1",
  "type": "object",
  "required": ["contract_id", "principal_id", "intent_id", "decision_case_sha256", "evidence_report_sha256", "subject_id", "object_id", "capability", "tool_id", "execution_target", "payload_sha256", "policy_id", "policy_sequence", "state_witness", "risk_class", "nonce", "issued_at", "expires_at", "approvals", "scope_sha256", "action_sha256"],
  "properties": {
    "contract_id": {"const": "TRIAXIS_ACTION_ASSURANCE_ENVELOPE_v1"},
    "principal_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "decision_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "execution_target": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_sequence": {"type": "integer", "minimum": 1},
    "state_witness": {"type": "object"},
    "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "nonce": {"type": "string", "minLength": 1},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
