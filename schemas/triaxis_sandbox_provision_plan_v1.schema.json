{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_sandbox_provision_plan_v1.schema.json",
  "title": "TRIAXIS Sandbox Provision Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "sandbox_id", "profile_id", "child_session_id", "repository_manifest_sha256", "allowed_capabilities", "network_mode", "network_allowlist", "read_paths", "write_paths", "env_allowlist", "budgets", "expires_at_tick", "plan_sha256"],
  "properties": {
    "contract_id": {"const": "TRIAXIS_SANDBOX_PROVISION_PLAN_v1"},
    "sandbox_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "child_session_id": {"type": "string", "minLength": 1},
    "repository_manifest_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "allowed_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "network_mode": {"enum": ["DENY", "ALLOWLIST"]},
    "network_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "read_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "write_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "env_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_seconds", "memory_mb", "wall_seconds", "max_processes"],
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1},
        "max_processes": {"type": "integer", "minimum": 1}
      }
    },
    "expires_at_tick": {"type": "integer", "minimum": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
