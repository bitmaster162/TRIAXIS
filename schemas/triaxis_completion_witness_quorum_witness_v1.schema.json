{
  "$id": "https://triaxis.local/schemas/triaxis_completion_witness_quorum_witness_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS Completion Witness Quorum Witness v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_COMPLETION_WITNESS_QUORUM_WITNESS_v1"
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "witness_set_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_service_id": {
      "type": "string",
      "minLength": 1
    },
    "effect_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "ABSENT",
        "NO_EFFECT"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "provider_request_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at_tick": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "threshold": {
      "type": "integer",
      "minimum": 2
    },
    "member_count": {
      "type": "integer",
      "minimum": 2
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "witness_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "signer_id": {
            "type": "string",
            "minLength": 1
          },
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "trust_domain": {
            "type": "string",
            "minLength": 1
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "response_issued_at": {
            "type": "integer",
            "minimum": 0
          },
          "response_valid_until": {
            "type": "integer",
            "minimum": 1
          },
          "witness_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "witness_head_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "witness_state_root_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "witness_id",
          "authority_id",
          "service_id",
          "signer_id",
          "key_id",
          "trust_domain",
          "response_sha256",
          "response_issued_at",
          "response_valid_until",
          "witness_sequence",
          "witness_head_event_sha256",
          "witness_state_root_sha256"
        ]
      }
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_epoch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_at": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_at": {
      "type": "integer",
      "minimum": 0
    },
    "blocking_minority_veto": {
      "type": "boolean"
    },
    "authority_granted": {
      "const": false
    },
    "witness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_id",
    "config_id",
    "config_sha256",
    "witness_set_id",
    "provider_id",
    "provider_service_id",
    "effect_id",
    "payload_sha256",
    "state",
    "generation",
    "provider_request_id",
    "provider_receipt_sha256",
    "evidence_sha256",
    "updated_at_tick",
    "threshold",
    "member_count",
    "members",
    "verifier_id",
    "verifier_epoch_sha256",
    "challenge_sha256",
    "requested_at",
    "evaluated_at",
    "blocking_minority_veto",
    "authority_granted",
    "witness_sha256"
  ]
}
