{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_sandbox_provision_attestation_v1.schema.json",
  "title": "TRIAXIS Sandbox Provision Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "attestor_id", "sandbox_receipt_sha256", "plan_sha256",
    "sandbox_id", "profile_id", "child_session_id", "repository_manifest_sha256",
    "backend_id", "state_dir_id", "pid_namespace_id", "mount_namespace_id",
    "network_namespace_id", "effective_capabilities", "network_mode",
    "runtime_measurement_sha256", "observed_features", "observed_at_tick",
    "expires_at_tick", "attestation_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_SANDBOX_PROVISION_ATTESTATION_v1"},
    "attestor_id": {"type": "string", "minLength": 1},
    "sandbox_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sandbox_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "child_session_id": {"type": "string", "minLength": 1},
    "repository_manifest_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "backend_id": {"type": "string", "minLength": 1},
    "state_dir_id": {"type": "string", "minLength": 1},
    "pid_namespace_id": {"type": "string", "minLength": 1},
    "mount_namespace_id": {"type": "string", "minLength": 1},
    "network_namespace_id": {"type": "string", "minLength": 1},
    "effective_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "network_mode": {"enum": ["DENY", "ALLOWLIST"]},
    "runtime_measurement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_at_tick": {"type": "integer", "minimum": 0},
    "expires_at_tick": {"type": "integer", "minimum": 1},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
