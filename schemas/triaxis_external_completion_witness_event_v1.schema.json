{
  "$id": "https://triaxis.local/schemas/triaxis_external_completion_witness_event_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS External Completion Witness Event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_EXTERNAL_COMPLETION_WITNESS_EVENT_v1"
    },
    "witness_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effect_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_service_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "provider_request_id": {
      "type": "string",
      "minLength": 1
    },
    "from_state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "RESERVED",
            "UNKNOWN",
            "COMPLETED",
            "NO_EFFECT"
          ]
        }
      ]
    },
    "to_state": {
      "enum": [
        "RESERVED",
        "UNKNOWN",
        "COMPLETED",
        "NO_EFFECT"
      ]
    },
    "provider_receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_response_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_at_tick": {
      "type": "integer",
      "minimum": 0
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_id",
    "witness_id",
    "authority_id",
    "service_id",
    "sequence",
    "previous_event_sha256",
    "effect_id",
    "payload_sha256",
    "provider_id",
    "provider_service_id",
    "generation",
    "provider_request_id",
    "from_state",
    "to_state",
    "provider_receipt_sha256",
    "provider_response_sha256",
    "evidence_sha256",
    "issued_at_tick",
    "event_sha256"
  ]
}
