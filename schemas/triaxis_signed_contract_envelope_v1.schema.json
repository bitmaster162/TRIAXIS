{
  "$id": "https://triaxis.local/schemas/triaxis_signed_contract_envelope_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "contract_id": {
      "const": "TRIAXIS_SIGNED_CONTRACT_ENVELOPE_v1"
    },
    "envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "inner_contract": {
      "type": "object"
    },
    "inner_contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "inner_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "inner_digest_field": {
      "minLength": 1,
      "type": "string"
    },
    "issued_at": {
      "minimum": 0,
      "type": "integer"
    },
    "key_id": {
      "minLength": 1,
      "type": "string"
    },
    "purpose": {
      "enum": [
        "ASSURANCE_ATTESTATION",
        "STATE_WITNESS",
        "ACTION_APPROVAL",
        "POLICY_BUNDLE",
        "AUTHORIZATION_TOKEN",
        "EXECUTION_RECEIPT",
        "TRUST_REGISTRY_SNAPSHOT",
        "TRUST_REGISTRY_ANCHOR",
        "SANDBOX_PROVISION_ATTESTATION"
      ]
    },
    "signature_b64": {
      "maxLength": 88,
      "minLength": 88,
      "type": "string"
    },
    "signer_id": {
      "minLength": 1,
      "type": "string"
    },
    "trust_domain": {
      "minLength": 1,
      "type": "string"
    },
    "valid_until": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "purpose",
    "algorithm",
    "key_id",
    "signer_id",
    "trust_domain",
    "issued_at",
    "valid_until",
    "inner_contract_id",
    "inner_digest_field",
    "inner_digest",
    "inner_contract",
    "envelope_sha256",
    "signature_b64"
  ],
  "title": "TRIAXIS Signed Contract Envelope v1",
  "type": "object"
}
