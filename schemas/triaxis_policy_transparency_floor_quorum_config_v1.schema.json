{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_policy_transparency_floor_quorum_config_v1.schema.json",
  "title": "TRIAXIS Policy Transparency Floor Quorum Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "config_id", "witness_set_id", "policy_id",
    "policy_head_quorum_config_sha256", "threshold", "witnesses",
    "valid_from", "valid_until", "config_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_POLICY_TRANSPARENCY_FLOOR_QUORUM_CONFIG_v1"},
    "config_id": {"type": "string", "minLength": 1},
    "witness_set_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_head_quorum_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "threshold": {"type": "integer", "minimum": 2},
    "witnesses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["witness_id", "log_id", "signer_id", "key_id", "trust_domain"],
        "properties": {
          "witness_id": {"type": "string", "minLength": 1},
          "log_id": {"type": "string", "minLength": 1},
          "signer_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "trust_domain": {"type": "string", "minLength": 1}
        }
      }
    },
    "valid_from": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
