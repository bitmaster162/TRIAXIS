{
  "$id": "https://triaxis.local/schemas/triaxis_tool_guardrail_result_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_TOOL_GUARDRAIL_RESULT_v1"
    },
    "guardrail_id": {
      "minLength": 1,
      "type": "string"
    },
    "observed_at_tick": {
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "PASS",
        "TRIPWIRE",
        "REWRITE",
        "HOLD"
      ]
    },
    "phase": {
      "enum": [
        "PRE_APPROVAL",
        "PRE_EXECUTION",
        "POST_EXECUTION"
      ]
    },
    "replacement_output_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "phase",
    "guardrail_id",
    "request_sha256",
    "outcome",
    "observed_at_tick",
    "replacement_output_sha256",
    "result_sha256"
  ],
  "title": "TRIAXIS Tool Guardrail Result v1",
  "type": "object"
}
