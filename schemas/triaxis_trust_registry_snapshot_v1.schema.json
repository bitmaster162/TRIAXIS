{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_trust_registry_snapshot_v1.schema.json",
  "title": "TRIAXIS Trust Registry Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "registry_id", "sequence", "parent_snapshot_sha256",
    "issued_at", "valid_until", "key_records", "snapshot_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_TRUST_REGISTRY_SNAPSHOT_v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "parent_snapshot_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "issued_at": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "key_records": {
      "type": "array",
      "items": {"$ref": "triaxis_ed25519_trust_key_v1.schema.json"}
    },
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
