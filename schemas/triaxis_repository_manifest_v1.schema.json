{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_repository_manifest_v1.schema.json",
  "title": "TRIAXIS Repository Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "manifest_id", "session_id", "observer_id", "observed_at_tick", "expires_at_tick", "repositories", "manifest_sha256"],
  "properties": {
    "contract_id": {"const": "TRIAXIS_REPOSITORY_MANIFEST_v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "observer_id": {"type": "string", "minLength": 1},
    "observed_at_tick": {"type": "integer", "minimum": 0},
    "expires_at_tick": {"type": "integer", "minimum": 1},
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repo_id", "root_logical_path", "worktree_ref", "baseline_commit", "clean", "writable"],
        "properties": {
          "repo_id": {"type": "string", "minLength": 1},
          "root_logical_path": {"type": "string", "minLength": 1},
          "worktree_ref": {"type": "string", "minLength": 1},
          "baseline_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
          "clean": {"type": "boolean"},
          "writable": {"type": "boolean"}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
