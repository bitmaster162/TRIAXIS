{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://triaxis.local/schemas/triaxis_policy_transparency_gossip_head_quorum_config_v1.schema.json",
  "title":"TRIAXIS Policy Transparency Gossip Head Quorum Config v1",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_id","config_id","authority_set_id","store_id","threshold","authorities","valid_from","valid_until","config_sha256"],
  "properties":{
    "contract_id":{"const":"TRIAXIS_POLICY_TRANSPARENCY_GOSSIP_HEAD_QUORUM_CONFIG_v1"},
    "config_id":{"type":"string","minLength":1},
    "authority_set_id":{"type":"string","minLength":1},
    "store_id":{"type":"string","minLength":1},
    "threshold":{"type":"integer","minimum":2},
    "authorities":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["authority_id","service_id","signer_id","key_id","trust_domain"],"properties":{"authority_id":{"type":"string","minLength":1},"service_id":{"type":"string","minLength":1},"signer_id":{"type":"string","minLength":1},"key_id":{"type":"string","minLength":1},"trust_domain":{"type":"string","minLength":1}}}},
    "valid_from":{"type":"integer","minimum":0},
    "valid_until":{"type":"integer","minimum":1},
    "config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
