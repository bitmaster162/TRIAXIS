{
  "$id": "https://triaxis.local/schemas/triaxis_completion_availability_witness_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS Completion Availability Witness v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_COMPLETION_AVAILABILITY_WITNESS_v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "risk_class": {
      "enum": [
        "HIGH",
        "CRITICAL"
      ]
    },
    "availability_mode": {
      "const": "ALL_CONFIGURED_REQUIRED"
    },
    "completion_quorum_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completion_quorum_witness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effect_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_service_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ABSENT",
        "NO_EFFECT"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "configured_witness_count": {
      "type": "integer",
      "minimum": 2
    },
    "responding_witness_count": {
      "type": "integer",
      "minimum": 2
    },
    "missing_witness_ids": {
      "type": "array",
      "maxItems": 0
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "witness_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "signer_id": {
            "type": "string",
            "minLength": 1
          },
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "trust_domain": {
            "type": "string",
            "minLength": 1
          },
          "witness_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "witness_head_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "witness_state_root_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "response_issued_at": {
            "type": "integer",
            "minimum": 0
          },
          "response_valid_until": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "witness_id",
          "authority_id",
          "service_id",
          "signer_id",
          "key_id",
          "trust_domain",
          "witness_sequence",
          "witness_head_event_sha256",
          "witness_state_root_sha256",
          "response_sha256",
          "response_issued_at",
          "response_valid_until"
        ]
      }
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_epoch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_at": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_at": {
      "type": "integer",
      "minimum": 0
    },
    "authority_granted": {
      "const": false
    },
    "witness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_id",
    "policy_id",
    "policy_sha256",
    "risk_class",
    "availability_mode",
    "completion_quorum_config_sha256",
    "completion_quorum_witness_sha256",
    "effect_id",
    "payload_sha256",
    "provider_id",
    "provider_service_id",
    "state",
    "generation",
    "configured_witness_count",
    "responding_witness_count",
    "missing_witness_ids",
    "members",
    "verifier_id",
    "verifier_epoch_sha256",
    "challenge_sha256",
    "requested_at",
    "evaluated_at",
    "authority_granted",
    "witness_sha256"
  ]
}
