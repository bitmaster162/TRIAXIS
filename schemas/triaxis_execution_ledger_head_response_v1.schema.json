{
  "$id": "https://triaxis.local/schemas/triaxis_execution_ledger_head_response_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS Execution Ledger Head Response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {"const": "TRIAXIS_EXECUTION_LEDGER_HEAD_RESPONSE_v1"},
    "authority_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "ledger_id": {"type": "string", "minLength": 1},
    "ledger_authority_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_epoch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "challenge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "integer", "minimum": 0},
    "ledger_sequence": {"type": "integer", "minimum": 0},
    "ledger_head_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_state_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_head_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_at_tick": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "contract_id", "authority_id", "service_id", "ledger_id", "ledger_authority_id",
    "verifier_id", "verifier_epoch_sha256", "challenge_sha256", "requested_at",
    "ledger_sequence", "ledger_head_event_sha256", "ledger_state_root_sha256",
    "ledger_head_sha256", "accepted_at_tick", "issued_at", "valid_until",
    "response_sha256"
  ]
}
