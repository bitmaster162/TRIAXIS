{
  "$id": "https://triaxis.local/schemas/triaxis_completion_worm_anchor_head_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS Completion WORM Anchor Head v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_COMPLETION_WORM_ANCHOR_HEAD_v1"
    },
    "anchor_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_service_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "head_event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at_tick": {
      "type": "integer",
      "minimum": 0
    },
    "authority_granted": {
      "const": false
    },
    "head_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_id",
    "anchor_id",
    "authority_id",
    "service_id",
    "provider_id",
    "provider_service_id",
    "sequence",
    "head_event_sha256",
    "state_root_sha256",
    "issued_at_tick",
    "authority_granted",
    "head_sha256"
  ]
}
