{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_trust_registry_challenge_witness_v1.schema.json",
  "title": "TRIAXIS Trust Registry Challenge Witness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "anchor_id", "registry_id", "sequence",
    "snapshot_sha256", "verifier_id", "challenge_sha256",
    "requested_at", "issued_at", "valid_until", "witness_sha256"
  ],
  "properties": {
    "contract_id": {"const": "TRIAXIS_TRUST_REGISTRY_CHALLENGE_WITNESS_v1"},
    "anchor_id": {"type": "string", "minLength": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_id": {"type": "string", "minLength": 1},
    "challenge_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 0},
    "witness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
