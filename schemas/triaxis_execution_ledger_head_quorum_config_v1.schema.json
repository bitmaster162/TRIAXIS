{
  "$id": "https://triaxis.local/schemas/triaxis_execution_ledger_head_quorum_config_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIAXIS Execution Ledger Head Quorum Config v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_EXECUTION_LEDGER_HEAD_QUORUM_CONFIG_v1"
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_set_id": {
      "type": "string",
      "minLength": 1
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "threshold": {
      "type": "integer",
      "minimum": 2
    },
    "authorities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authority_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "signer_id": {
            "type": "string",
            "minLength": 1
          },
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "trust_domain": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "authority_id",
          "service_id",
          "signer_id",
          "key_id",
          "trust_domain"
        ]
      }
    },
    "valid_from": {
      "type": "integer",
      "minimum": 0
    },
    "valid_until": {
      "type": "integer",
      "minimum": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_id",
    "config_id",
    "authority_set_id",
    "ledger_id",
    "threshold",
    "authorities",
    "valid_from",
    "valid_until",
    "config_sha256"
  ]
}
