{
  "$id": "https://triaxis.local/schemas/triaxis_ed25519_trust_key_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "contract_id": {
      "const": "TRIAXIS_ED25519_TRUST_KEY_v1"
    },
    "key_id": {
      "minLength": 1,
      "type": "string"
    },
    "key_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_key_b64": {
      "maxLength": 44,
      "minLength": 44,
      "type": "string"
    },
    "purposes": {
      "items": {
        "enum": [
          "ASSURANCE_ATTESTATION",
          "STATE_WITNESS",
          "ACTION_APPROVAL",
          "POLICY_BUNDLE",
          "AUTHORIZATION_TOKEN",
          "EXECUTION_RECEIPT",
          "TRUST_REGISTRY_SNAPSHOT",
          "TRUST_REGISTRY_ANCHOR",
          "ANCHOR_QUORUM_POLICY",
          "POLICY_HEAD_AUTHORITY",
          "POLICY_TRANSPARENCY_WITNESS",
          "POLICY_TRANSPARENCY_GOSSIP_CHECKPOINT",
          "POLICY_TRANSPARENCY_GOSSIP_HEAD_AUTHORITY",
          "SANDBOX_PROVISION_ATTESTATION"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "revoked_at": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "signer_id": {
      "minLength": 1,
      "type": "string"
    },
    "trust_domain": {
      "minLength": 1,
      "type": "string"
    },
    "valid_from": {
      "minimum": 0,
      "type": "integer"
    },
    "valid_until": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "key_id",
    "signer_id",
    "trust_domain",
    "algorithm",
    "public_key_b64",
    "purposes",
    "valid_from",
    "valid_until",
    "revoked_at",
    "key_record_sha256"
  ],
  "title": "TRIAXIS Ed25519 Trust Key v1",
  "type": "object"
}
