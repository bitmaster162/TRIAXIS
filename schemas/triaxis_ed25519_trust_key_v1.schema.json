{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triaxis.local/schemas/triaxis_ed25519_trust_key_v1.schema.json",
  "title": "TRIAXIS Ed25519 Trust Key v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "key_id",
    "signer_id",
    "trust_domain",
    "algorithm",
    "public_key_b64",
    "purposes",
    "valid_from",
    "valid_until",
    "revoked_at",
    "key_record_sha256"
  ],
  "properties": {
    "contract_id": {
      "const": "TRIAXIS_ED25519_TRUST_KEY_v1"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signer_id": {
      "type": "string",
      "minLength": 1
    },
    "trust_domain": {
      "type": "string",
      "minLength": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "public_key_b64": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ASSURANCE_ATTESTATION",
          "STATE_WITNESS",
          "ACTION_APPROVAL",
          "POLICY_BUNDLE",
          "AUTHORIZATION_TOKEN",
          "EXECUTION_RECEIPT",
          "TRUST_REGISTRY_SNAPSHOT",
          "TRUST_REGISTRY_ANCHOR"
        ]
      }
    },
    "valid_from": {
      "type": "integer",
      "minimum": 0
    },
    "valid_until": {
      "type": "integer",
      "minimum": 0
    },
    "revoked_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "key_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
