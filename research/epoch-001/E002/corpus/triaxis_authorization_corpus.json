  "description": "Common TRIAXIS Authorization Corpus — 20 Engine-Neutral Test Cases",
  "test_cases": [
    {
      "id": "TC01_EXPLICIT_ALLOW",
      "name": "Explicit Allow",
      "principal": {"type": "User", "id": "alice"},
      "action": {"type": "Action", "id": "read"},
      "resource": {"type": "Document", "id": "doc_1"},
      "context": {"ip": "10.0.0.1", "time": "2026-08-08T10:00:00Z"},
      "delegation": null,
      "policy_version": "v1",
      "expected_decision": "ALLOW",
      "expected_reason": "Matching permit policy for alice on doc_1 read"
    },
    {
      "id": "TC02_EXPLICIT_DENY",
      "name": "Explicit Deny Overrides Allow",
      "principal": {"type": "User", "id": "bob"},
      "action": {"type": "Action", "id": "delete"},
      "resource": {"type": "Document", "id": "doc_1"},
      "context": {"ip": "10.0.0.1", "time": "2026-08-08T10:00:00Z"},
      "delegation": null,
      "policy_version": "v1",
      "expected_decision": "DENY",
      "expected_reason": "Explicit forbid policy overrides default/permit policies"
    },
    {
      "id": "TC03_NO_MATCHING_POLICY",
