+    attestation_raw = {
+        "contract_id": ASSURANCE_ATTESTATION_CONTRACT_ID,
+        "attestation_id": f"att_{eff_task}",
+        "issuer_id": "issuer_001",
+        "trust_domain": "dev.domain",
