FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY tools/run_completion_transparency_authority.py ./tools/run_completion_transparency_authority.py
ENV PYTHONPATH=/app/src:/app
ENTRYPOINT ["python","tools/run_completion_transparency_authority.py"]
