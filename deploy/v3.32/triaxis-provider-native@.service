[Unit]
Description=TRIAXIS v3.32 provider-native local reference %i
[Service]
Type=simple
Environment=PYTHONPATH=/opt/triaxis/src:/opt/triaxis
EnvironmentFile=/etc/triaxis/provider-native-%i.env
ExecStart=/usr/bin/python3 /opt/triaxis/tools/run_provider_native_idempotency.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/triaxis/provider-native-%i
[Install]
WantedBy=multi-user.target
