[Unit]
Description=TRIAXIS v3.32 completion transparency local reference %i
[Service]
Type=simple
Environment=PYTHONPATH=/opt/triaxis/src:/opt/triaxis
EnvironmentFile=/etc/triaxis/completion-transparency-%i.env
ExecStart=/usr/bin/python3 /opt/triaxis/tools/run_completion_transparency_authority.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/triaxis/completion-transparency-%i
[Install]
WantedBy=multi-user.target
