# Reference only. The filesystem implementation uses content-addressed O_EXCL
# writes and exposes no overwrite/delete API. It is not physical WORM media and
# must not be described as independent or hardware-backed storage.
TRIAXIS_CIA_ROOT=/var/lib/triaxis-completion-immutable-anchor/store
TRIAXIS_CIA_PROVIDER_KEYS_JSON=/etc/triaxis/provider-public-keys.json
TRIAXIS_CIA_EXPECTED_PROVIDER_SIGNER_ID=signer:provider:reference
TRIAXIS_CIA_EXPECTED_PROVIDER_TRUST_DOMAIN=triaxis:provider:reference
TRIAXIS_CIA_ANCHOR_ID=completion-immutable-anchor:primary
TRIAXIS_CIA_AUTHORITY_ID=authority:completion-immutable-anchor:primary
TRIAXIS_CIA_SERVICE_ID=service:completion-immutable-anchor:primary
TRIAXIS_CIA_PROVIDER_ID=provider:reference
TRIAXIS_CIA_PROVIDER_SERVICE_ID=service:provider:reference
TRIAXIS_CIA_RETENTION_POLICY_ID=retention:completion:high-risk
TRIAXIS_CIA_KEY_ID=key:completion-immutable-anchor:primary
TRIAXIS_CIA_SIGNER_ID=signer:completion-immutable-anchor:primary
TRIAXIS_CIA_TRUST_DOMAIN=triaxis:completion-immutable-anchor
TRIAXIS_CIA_HOST=127.0.0.1
TRIAXIS_CIA_PORT=18878
TRIAXIS_CIA_RESPONSE_TTL=10
TRIAXIS_CIA_MAX_PROVIDER_RECEIPT_AGE=30
TRIAXIS_CIA_MINIMUM_RETENTION_TICKS=100
TRIAXIS_CIA_PRIVATE_KEY_CREDENTIAL_NAME=completion-immutable-anchor-private-key
TRIAXIS_CIA_CLIENT_TOKEN_CREDENTIAL_NAME=completion-immutable-anchor-client-token
