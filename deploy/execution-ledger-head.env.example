# Reference only. Keep signing keys and admin tokens in a secret manager or
# systemd credentials; do not commit them to an environment file.
TRIAXIS_ELH_DB=/var/lib/triaxis-execution-ledger-head/head.sqlite
TRIAXIS_ELH_LEDGER_KEYS_JSON=/etc/triaxis/execution-ledger-public-keys.json
TRIAXIS_ELH_EXPECTED_LEDGER_SIGNER_ID=signer:ledger:primary
TRIAXIS_ELH_EXPECTED_LEDGER_TRUST_DOMAIN=triaxis:execution-ledger
TRIAXIS_ELH_AUTHORITY_ID=authority:execution-ledger-head:primary
TRIAXIS_ELH_SERVICE_ID=service:execution-ledger-head:primary
TRIAXIS_ELH_KEY_ID=key:execution-ledger-head:primary
TRIAXIS_ELH_SIGNER_ID=signer:execution-ledger-head:primary
TRIAXIS_ELH_TRUST_DOMAIN=triaxis:execution-ledger-head
TRIAXIS_ELH_HOST=127.0.0.1
TRIAXIS_ELH_PORT=18874
TRIAXIS_ELH_RESPONSE_TTL=10
TRIAXIS_ELH_PRIVATE_KEY_CREDENTIAL_NAME=execution-ledger-head-private-key
TRIAXIS_ELH_ADMIN_TOKEN_CREDENTIAL_NAME=execution-ledger-head-admin-token
