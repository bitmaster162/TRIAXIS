# Reference only. Keep signing keys and bearer tokens in a secret manager or
# systemd credentials. This SQLite service is a logical append-only anchor; it
# is not physical WORM storage and must not be described as such.
TRIAXIS_CWA_DB=/var/lib/triaxis-completion-worm-anchor/anchor.sqlite
TRIAXIS_CWA_PROVIDER_KEYS_JSON=/etc/triaxis/provider-public-keys.json
TRIAXIS_CWA_EXPECTED_PROVIDER_SIGNER_ID=signer:provider:reference
TRIAXIS_CWA_EXPECTED_PROVIDER_TRUST_DOMAIN=triaxis:provider:reference
TRIAXIS_CWA_ANCHOR_ID=completion-worm-anchor:primary
TRIAXIS_CWA_AUTHORITY_ID=authority:completion-worm-anchor:primary
TRIAXIS_CWA_SERVICE_ID=service:completion-worm-anchor:primary
TRIAXIS_CWA_PROVIDER_ID=provider:reference
TRIAXIS_CWA_PROVIDER_SERVICE_ID=service:provider:reference
TRIAXIS_CWA_KEY_ID=key:completion-worm-anchor:primary
TRIAXIS_CWA_SIGNER_ID=signer:completion-worm-anchor:primary
TRIAXIS_CWA_TRUST_DOMAIN=triaxis:completion-worm-anchor
TRIAXIS_CWA_HOST=127.0.0.1
TRIAXIS_CWA_PORT=18877
TRIAXIS_CWA_RESPONSE_TTL=10
TRIAXIS_CWA_MAX_PROVIDER_RECEIPT_AGE=30
TRIAXIS_CWA_PRIVATE_KEY_CREDENTIAL_NAME=completion-worm-anchor-private-key
TRIAXIS_CWA_CLIENT_TOKEN_CREDENTIAL_NAME=completion-worm-anchor-client-token
