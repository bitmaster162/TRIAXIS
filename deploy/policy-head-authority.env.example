# No private values are included. Copy to a protected root-readable environment file.
TRIAXIS_PHA_POLICY_DB=/var/lib/triaxis-policy-head/policy.db
TRIAXIS_PHA_RESPONSE_DB=/var/lib/triaxis-policy-head/responses.db
TRIAXIS_PHA_POLICY_ROOT_KEYS_JSON=/etc/triaxis-policy-head/policy-root-keys.json
TRIAXIS_PHA_POLICY_ID=quorum-policy:main
TRIAXIS_PHA_POLICY_ROOT_SIGNER_ID=quorum-policy-root:1
TRIAXIS_PHA_POLICY_ROOT_TRUST_DOMAIN=domain:quorum-policy-root
TRIAXIS_PHA_AUTHORITY_ID=policy-head:primary
TRIAXIS_PHA_KEY_ID=key:policy-head:1
TRIAXIS_PHA_SIGNER_ID=policy-head-service:1
TRIAXIS_PHA_TRUST_DOMAIN=domain:policy-head
TRIAXIS_PHA_PRIVATE_KEY_B64=SET_VIA_SECRET_MANAGER
TRIAXIS_PHA_ADMIN_TOKEN=SET_VIA_SECRET_MANAGER
TRIAXIS_PHA_HOST=127.0.0.1
TRIAXIS_PHA_PORT=8787
TRIAXIS_PHA_RESPONSE_TTL=10
