# Reference provider only; it performs no real vendor action.
TRIAXIS_IDP_DB=/var/lib/triaxis-idempotent-provider/provider.sqlite
TRIAXIS_IDP_PROVIDER_ID=provider:reference
TRIAXIS_IDP_SERVICE_ID=service:reference-effect
TRIAXIS_IDP_KEY_ID=key:provider:reference
TRIAXIS_IDP_SIGNER_ID=signer:provider:reference
TRIAXIS_IDP_TRUST_DOMAIN=triaxis:provider:reference
TRIAXIS_IDP_HOST=127.0.0.1
TRIAXIS_IDP_PORT=18875
TRIAXIS_IDP_RESPONSE_TTL=10
TRIAXIS_IDP_PRIVATE_KEY_CREDENTIAL_NAME=idempotent-provider-private-key
TRIAXIS_IDP_CLIENT_TOKEN_CREDENTIAL_NAME=idempotent-provider-client-token
