# Reference only. Keep signing keys and bearer tokens in a secret manager or
# systemd credentials; do not commit them to an environment file.
TRIAXIS_ECW_DB=/var/lib/triaxis-external-completion-witness/witness.sqlite
TRIAXIS_ECW_PROVIDER_KEYS_JSON=/etc/triaxis/provider-public-keys.json
TRIAXIS_ECW_EXPECTED_PROVIDER_SIGNER_ID=signer:provider:reference
TRIAXIS_ECW_EXPECTED_PROVIDER_TRUST_DOMAIN=triaxis:provider:reference
TRIAXIS_ECW_WITNESS_ID=completion-witness:primary
TRIAXIS_ECW_AUTHORITY_ID=authority:completion-witness:primary
TRIAXIS_ECW_SERVICE_ID=service:completion-witness:primary
TRIAXIS_ECW_KEY_ID=key:completion-witness:primary
TRIAXIS_ECW_SIGNER_ID=signer:completion-witness:primary
TRIAXIS_ECW_TRUST_DOMAIN=triaxis:completion-witness
TRIAXIS_ECW_HOST=127.0.0.1
TRIAXIS_ECW_PORT=18876
TRIAXIS_ECW_RESPONSE_TTL=10
TRIAXIS_ECW_MAX_PROVIDER_RECEIPT_AGE=30
TRIAXIS_ECW_PRIVATE_KEY_CREDENTIAL_NAME=external-completion-witness-private-key
TRIAXIS_ECW_CLIENT_TOKEN_CREDENTIAL_NAME=external-completion-witness-client-token
